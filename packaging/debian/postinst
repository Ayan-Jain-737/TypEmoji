#!/bin/sh
set -e

case "$1" in
    configure)
        # Update desktop database
        if which update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi

        # Update icon cache
        if which gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
        fi

        # Clean up legacy global systemd service if present to avoid dual-tray-icon conflicts with XDG autostart
        if which systemctl >/dev/null 2>&1; then
            systemctl --global disable emojityper.service >/dev/null 2>&1 || true
            systemctl --global daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
